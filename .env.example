# ============================================================
# ENV VARIABLES - Ordini-Lampo API v2.2
# ============================================================

# Server
NODE_ENV=production
PORT=3000

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB?sslmode=require

# CORS (frontend origins, comma-separated)
ALLOWED_ORIGINS=https://ordinlampo.netlify.app,https://ordini-lampo.it

# Session Cookie
SESSION_COOKIE_NAME=ol_session
SESSION_SAMESITE=none
SESSION_TTL_MS=86400000

# CSRF
CSRF_COOKIE_NAME=ol_csrf
CSRF_HEADER_NAME=x-ol-csrf

# Switch Tenant Token (GENERATE RANDOM 64 CHAR)
SWITCH_TENANT_SECRET=your-64-char-random-secret-here-generate-with-openssl-rand-hex-32

# Password Security
PASSWORD_PEPPER=your-64-char-random-pepper-here-generate-with-openssl-rand-hex-32
BCRYPT_COST=12

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
MAX_SESSIONS_PER_USER=10

# GOV Guard
GOV_MODE_CACHE_TTL_MS=8000

# Switch Token
SWITCH_TOKEN_TTL_MS=300000
SWITCH_TOKEN_SKEW_MS=30000

# Database Pool
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
